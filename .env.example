# Copy to .env.local for local development; set the same variables in Vercel.

# Neon Postgres connection string (pgvector is enabled by the first migration).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: <app origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The one Google account allowed to sign in. Every other account is refused.
LEARNER_EMAIL=you@example.com
