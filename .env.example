# Copy to .env.local for local development; set the same variables in Vercel.

# Neon Postgres connection string (pgvector is enabled by the first migration).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Auth.js. Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI: <app origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The one Google account allowed to sign in. Every other account is refused.
LEARNER_EMAIL=you@example.com

# OpenAI: every AI task (Topic proposal and matching, embeddings, ...).
OPENAI_API_KEY=
# Optional overrides. The embedding model must produce 1536-dimension vectors.
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vercel Blob: the file store for uploaded files (.md, PDF). Create a Blob store in the
# Vercel project (Storage tab) and connect it; Vercel then sets this automatically.
BLOB_READ_WRITE_TOKEN=

# Protects /api/jobs/run, the cron safety net that drains background jobs.
# Vercel Cron sends it automatically as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
